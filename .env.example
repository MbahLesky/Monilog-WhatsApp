# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
# Public HTTPS base URL this service is reachable at (used for Twilio signature
# verification). Behind a tunnel/proxy set this to the exact URL WhatsApp calls,
# e.g. https://moniilog-bot.example.com  (no trailing slash).
PUBLIC_URL=
# Set to "true" ONLY for local development to skip provider signature checks.
SKIP_SIGNATURE_CHECK=false

# ── Provider selection ────────────────────────────────────────────────────
# "meta" (default — free for this bot's usage) or "twilio" (adds a reseller
# markup on top of Meta's fees; kept only as an alternative).
WHATSAPP_PROVIDER=meta

# ── Supabase (Single source of truth) ─────────────────────────────────────
# Supabase project URL and service-role key (Project Settings > API).
# The service-role key is required to query profiles by phone_number across users.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Meta WhatsApp Cloud API (default) ──────────────────────────────────────
# Token you invent and paste into the Meta webhook config; echoed back on the
# GET verification handshake.
META_VERIFY_TOKEN=
# App secret (App settings → Basic) — verifies X-Hub-Signature-256 on inbound POSTs.
META_APP_SECRET=
# Access token used to send replies. The 24h test token works for development;
# generate a permanent System User token for production.
META_ACCESS_TOKEN=
# The phone number ID (not the phone number itself) from WhatsApp → API Setup.
META_PHONE_NUMBER_ID=

# ── Twilio (only if WHATSAPP_PROVIDER=twilio) ──────────────────────────────
# Auth token is required to verify inbound webhook signatures.
TWILIO_AUTH_TOKEN=
# The sandbox / sender number, E.164 with country code, e.g. +14155238886
TWILIO_WHATSAPP_FROM=

# ── Formatting ─────────────────────────────────────────────────────────────
# Fallback currency when a user has no synced settings yet (Moniilog default).
DEFAULT_CURRENCY=XAF
